<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>$(Version)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;CS1591;IDE0130;IDE1006;NU1902;NU1903;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\..\config\AppSettings.json">
      <Link>AppSettings.json</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\config\AppSettings.local.json" Condition="Exists('..\..\..\config\AppSettings.local.json')">
      <Link>AppSettings.local.json</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\library\Shift.Common\Shift.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Analyzer Include="..\..\..\build\references\EyeSpy.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
