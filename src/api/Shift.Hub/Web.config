<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<location path="." inheritInChildApplications="false">
		<system.webServer>
			<handlers>
				<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
			</handlers>
			<aspNetCore processPath="dotnet" arguments=".\bin\Debug\net9.0\Shift.Hub.dll" stdoutLogEnabled="false" stdoutLogFile=".\tmp\log\stdout" hostingModel="inprocess" />
		</system.webServer>
	</location>
	<system.web>
		<compilation debug="true">
		</compilation>
	</system.web>
</configuration>
